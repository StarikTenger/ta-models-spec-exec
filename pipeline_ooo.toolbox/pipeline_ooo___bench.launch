<?xml version="1.0" encoding="UTF-8" standalone="no"?>
<launchConfiguration type="org.lamport.tla.toolbox.tool.tlc.modelCheck">
    <stringAttribute key="TLCCmdLineParameters" value=""/>
    <intAttribute key="collectCoverage" value="0"/>
    <stringAttribute key="configurationName" value="bench"/>
    <booleanAttribute key="deferLiveness" value="false"/>
    <intAttribute key="dfidDepth" value="100"/>
    <booleanAttribute key="dfidMode" value="false"/>
    <intAttribute key="distributedFPSetCount" value="0"/>
    <stringAttribute key="distributedNetworkInterface" value="192.168.1.58"/>
    <intAttribute key="distributedNodesCount" value="1"/>
    <stringAttribute key="distributedTLC" value="off"/>
    <stringAttribute key="distributedTLCVMArgs" value=""/>
    <intAttribute key="fpBits" value="1"/>
    <intAttribute key="fpIndex" value="28"/>
    <booleanAttribute key="fpIndexRandom" value="true"/>
    <intAttribute key="maxHeapSize" value="49"/>
    <intAttribute key="maxSetSize" value="1000000"/>
    <booleanAttribute key="mcMode" value="true"/>
    <stringAttribute key="modelBehaviorInit" value=""/>
    <stringAttribute key="modelBehaviorNext" value=""/>
    <stringAttribute key="modelBehaviorSpec" value="Spec"/>
    <intAttribute key="modelBehaviorSpecType" value="1"/>
    <stringAttribute key="modelBehaviorVars" value="_RS2, _COM2, _ID, _IF, _FU2, _COM, exec_inst2, _ID2, graph, currCycle2, _IF2, lastBound, graph2, pc2, robHead, rob, _RS, currCycle, exec_inst, robHead2, pc, rob2, _FU"/>
    <stringAttribute key="modelComments" value=""/>
    <booleanAttribute key="modelCorrectnessCheckDeadlock" value="true"/>
    <listAttribute key="modelCorrectnessInvariants">
        <listEntry value="0currCycle &lt; 20 \/ graph = graph2"/>
        <listEntry value="0\A i \in 2..Len(rob): rob[i].executed =&gt; rob[i-1].executed"/>
        <listEntry value="0\E r \in {rob,rob2} : Len(r) /= Len(program) \/ \E i \in DOMAIN r: ~r[i].done \/ graph = graph2"/>
        <listEntry value="0\* NoTA&#10;Variation =&gt; ~HasTA(graph, graph2, currCycle)"/>
        <listEntry value="1NoTA(TRUE)"/>
    </listAttribute>
    <listAttribute key="modelCorrectnessProperties"/>
    <intAttribute key="modelEditorOpenTabs" value="12"/>
    <stringAttribute key="modelExpressionEval" value="Len(program)"/>
    <listAttribute key="modelParameterConstants">
        <listEntry value="missLat;;3;0;0"/>
        <listEntry value="mayDMiss;;{1};0;0"/>
        <listEntry value="N_FU;;4;0;0"/>
        <listEntry value="superscal;;2;0;0"/>
        <listEntry value="mayIMiss;;{};0;0"/>
        <listEntry value="RSsize;;12;0;0"/>
        <listEntry value="program;;&lt;&lt;&#10;[ ind |-&gt; 1, type |-&gt; &quot;MemRead&quot;, r0 |-&gt; &quot;ra&quot;, r1 |-&gt; &quot;&quot;, r2 |-&gt; &quot;&quot;, targA |-&gt; &quot;&quot; ],&#10;[ ind |-&gt; 2, type |-&gt; &quot;IntAlu&quot;, r0 |-&gt; &quot;&quot;, r1 |-&gt; &quot;ra&quot;, r2 |-&gt; &quot;&quot;, targA |-&gt; &quot;&quot; ],&#10;[ ind |-&gt; 3, type |-&gt; &quot;IntAlu&quot;, r0 |-&gt; &quot;rb&quot;, r1 |-&gt; &quot;&quot;, r2 |-&gt; &quot;&quot;, targA |-&gt; &quot;&quot; ],&#10;[ ind |-&gt; 4, type |-&gt; &quot;MemWrite&quot;, r0 |-&gt; &quot;&quot;, r1 |-&gt; &quot;rb&quot;, r2 |-&gt; &quot;&quot;, targA |-&gt; &quot;&quot; ]&#10;&gt;&gt;;0;0"/>
        <listEntry value="robSize;;12;0;0"/>
        <listEntry value="name;;&quot;test&quot;;0;0"/>
        <listEntry value="lat;;[ IntAlu |-&gt; 3, MemRead |-&gt; 1, MemWrite |-&gt; 3, IntDiv |-&gt; 4, IntMult |-&gt; 4 ];0;0"/>
    </listAttribute>
    <intAttribute key="modelVersion" value="20191005"/>
    <intAttribute key="numberOfWorkers" value="4"/>
    <booleanAttribute key="recover" value="false"/>
    <stringAttribute key="result.mail.address" value=""/>
    <intAttribute key="simuAril" value="-1"/>
    <intAttribute key="simuDepth" value="100"/>
    <intAttribute key="simuSeed" value="-1"/>
    <stringAttribute key="specName" value="pipeline_ooo"/>
    <stringAttribute key="tlcResourcesProfile" value="local custom"/>
    <listAttribute key="traceExploreExpressions">
        <listEntry value="0Exec1!Done"/>
        <listEntry value="0Exec1!NxtFU(1)"/>
        <listEntry value="1Exec1!NxtStallID"/>
        <listEntry value="1Exec1!FullRob"/>
    </listAttribute>
    <stringAttribute key="view" value=""/>
    <booleanAttribute key="visualizeStateGraph" value="false"/>
</launchConfiguration>
